  {"key": "alt+' c", "command": "type", "args": {"text": "ᶜ"}, "when": "editorTextFocus"},  // Superscript c (complement)
  {"key": "alt+' e", "command": "type", "args": {"text": "ᵉ"}, "when": "editorTextFocus"},  // Superscript e
  {"key": "alt+, e", "command": "type", "args": {"text": "ₑ"}, "when": "editorTextFocus"},  // Subscript e
  {"key": "alt+' h", "command": "type", "args": {"text": "ʰ"}, "when": "editorTextFocus"},  // Superscript h
  {"key": "alt+, h", "command": "type", "args": {"text": "ₕ"}, "when": "editorTextFocus"},  // Subscript h
