  {"key": "alt+, 1", "command": "type", "args": {"text": "₁"}, "when": "editorTextFocus"},  // Subscript 1
  {"key": "alt+' 2", "command": "type", "args": {"text": "²"}, "when": "editorTextFocus"},  // Superscript 2
  {"key": "alt+, 2", "command": "type", "args": {"text": "₂"}, "when": "editorTextFocus"},  // Subscript 2
  {"key": "alt+' 3", "command": "type", "args": {"text": "³"}, "when": "editorTextFocus"},  // Superscript 3
  {"key": "alt+, 3", "command": "type", "args": {"text": "₃"}, "when": "editorTextFocus"},  // Subscript 3
  {"key": "alt+' 4", "command": "type", "args": {"text": "⁴"}, "when": "editorTextFocus"},  // Superscript 4
  {"key": "alt+, 4", "command": "type", "args": {"text": "₄"}, "when": "editorTextFocus"},  // Subscript 4
  {"key": "alt+' 5", "command": "type", "args": {"text": "⁵"}, "when": "editorTextFocus"},  // Superscript 5
  {"key": "alt+, 5", "command": "type", "args": {"text": "₅"}, "when": "editorTextFocus"},  // Subscript 5
  {"key": "alt+' 6", "command": "type", "args": {"text": "⁶"}, "when": "editorTextFocus"},  // Superscript 6
  {"key": "alt+, 6", "command": "type", "args": {"text": "₆"}, "when": "editorTextFocus"},  // Subscript 6
  {"key": "alt+' 7", "command": "type", "args": {"text": "⁷"}, "when": "editorTextFocus"},  // Superscript 7
  {"key": "alt+, 7", "command": "type", "args": {"text": "₇"}, "when": "editorTextFocus"},  // Subscript 7
  {"key": "alt+' 8", "command": "type", "args": {"text": "⁸"}, "when": "editorTextFocus"},  // Superscript 8
  {"key": "alt+, 8", "command": "type", "args": {"text": "₈"}, "when": "editorTextFocus"},  // Subscript 8
  {"key": "alt+' 9", "command": "type", "args": {"text": "⁹"}, "when": "editorTextFocus"},  // Superscript 9
  {"key": "alt+, 9", "command": "type", "args": {"text": "₉"}, "when": "editorTextFocus"},  // Subscript 9
  {"key": "alt+' shift+=", "command": "type", "args": {"text": "⁺"}, "when": "editorTextFocus"},  // Superscript Plus
  {"key": "alt+, shift+=", "command": "type", "args": {"text": "₊"}, "when": "editorTextFocus"},  // Subscript Plus
  {"key": "alt+' -", "command": "type", "args": {"text": "⁻"}, "when": "editorTextFocus"},  // Superscript Minus
  {"key": "alt+, -", "command": "type", "args": {"text": "₋"}, "when": "editorTextFocus"},  // Subscript Minus
  {"key": "alt+' =", "command": "type", "args": {"text": "⁼"}, "when": "editorTextFocus"},  // Superscript Equals
  {"key": "alt+, =", "command": "type", "args": {"text": "₌"}, "when": "editorTextFocus"},  // Subscript Equals
  {"key": "alt+' shift+9", "command": "type", "args": {"text": "⁽"}, "when": "editorTextFocus"},  // Superscript Left parenthesis
