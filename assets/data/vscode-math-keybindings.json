  {"key": "alt+o =", "command": "type", "args": {"text": "±"}, "when": "editorTextFocus"},  // Plus-minus
  {"key": "alt+o shift+=", "command": "type", "args": {"text": "∓"}, "when": "editorTextFocus"},  // Minus-plus
  {"key": "alt+o alt+/", "command": "type", "args": {"text": "/"}, "when": "editorTextFocus"},  // Solidus (slash)
  {"key": "alt+o shift+/", "command": "type", "args": {"text": "⁄"}, "when": "editorTextFocus"},  // Fraction slash
  {"key": "alt+o alt+=", "command": "type", "args": {"text": "="}, "when": "editorTextFocus"},  // Equals
  {"key": "alt+o n", "command": "type", "args": {"text": "≠"}, "when": "editorTextFocus"},  // Not equal
  {"key": "alt+o a", "command": "type", "args": {"text": "≈"}, "when": "editorTextFocus"},  // Approximately equal
  {"key": "alt+o e", "command": "type", "args": {"text": "≡"}, "when": "editorTextFocus"},  // Identical to / congruent (mod)
  {"key": "alt+o c", "command": "type", "args": {"text": "≅"}, "when": "editorTextFocus"},  // Congruent (geometry)
