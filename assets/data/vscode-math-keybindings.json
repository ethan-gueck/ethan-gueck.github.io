  {"key": "alt+' k", "command": "type", "args": {"text": "ᵏ"}, "when": "editorTextFocus"},  // Superscript k
  {"key": "alt+, k", "command": "type", "args": {"text": "ₖ"}, "when": "editorTextFocus"},  // Subscript k
  {"key": "alt+' l", "command": "type", "args": {"text": "ˡ"}, "when": "editorTextFocus"},  // Superscript l
  {"key": "alt+, l", "command": "type", "args": {"text": "ₗ"}, "when": "editorTextFocus"},  // Subscript l
  {"key": "alt+' m", "command": "type", "args": {"text": "ᵐ"}, "when": "editorTextFocus"},  // Superscript m
  {"key": "alt+, m", "command": "type", "args": {"text": "ₘ"}, "when": "editorTextFocus"},  // Subscript m
  {"key": "alt+' n", "command": "type", "args": {"text": "ⁿ"}, "when": "editorTextFocus"},  // Superscript n
  {"key": "alt+, n", "command": "type", "args": {"text": "ₙ"}, "when": "editorTextFocus"},  // Subscript n
  {"key": "alt+' o", "command": "type", "args": {"text": "ᵒ"}, "when": "editorTextFocus"},  // Superscript o
  {"key": "alt+, o", "command": "type", "args": {"text": "ₒ"}, "when": "editorTextFocus"},  // Subscript o
  {"key": "alt+' p", "command": "type", "args": {"text": "ᵖ"}, "when": "editorTextFocus"},  // Superscript p
  {"key": "alt+, p", "command": "type", "args": {"text": "ₚ"}, "when": "editorTextFocus"},  // Subscript p
  {"key": "alt+' s", "command": "type", "args": {"text": "ˢ"}, "when": "editorTextFocus"},  // Superscript s
  {"key": "alt+, s", "command": "type", "args": {"text": "ₛ"}, "when": "editorTextFocus"},  // Subscript s
  {"key": "alt+' t", "command": "type", "args": {"text": "ᵗ"}, "when": "editorTextFocus"},  // Superscript t
