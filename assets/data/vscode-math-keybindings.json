// Math symbol shortcuts for VS Code, from https://ethan-gueck.github.io/#misc (Ethan Gueck).
// Install: Command Palette (Ctrl+Shift+P / Cmd+Shift+P) → "Preferences: Open Keyboard Shortcuts (JSON)",
// then paste these entries inside the [ ] already in that file. On a Mac, Alt is the Option key.
// Each shortcut is a chord: press Alt+<prefix>, let go, then press the second key.
//   Alt+J Greek (Greek keyboard layout; Shift = capital)   Alt+' superscript   Alt+, subscript
//   Alt+O operators   Alt+U sets & logic   Alt+D calculus   Alt+/ arrows   Alt+M geometry   Alt+Q typography   Alt+B bold
// Every prefix is an Alt key VS Code leaves unbound by default on Windows, Mac and Linux.
[
  // Greek alphabet
  {"key": "alt+j shift+a", "command": "type", "args": {"text": "Α"}, "when": "editorTextFocus"},  // Capital alpha
  {"key": "alt+j a", "command": "type", "args": {"text": "α"}, "when": "editorTextFocus"},  // Alpha
  {"key": "alt+j shift+b", "command": "type", "args": {"text": "Β"}, "when": "editorTextFocus"},  // Capital beta
  {"key": "alt+j b", "command": "type", "args": {"text": "β"}, "when": "editorTextFocus"},  // Beta
  {"key": "alt+j shift+g", "command": "type", "args": {"text": "Γ"}, "when": "editorTextFocus"},  // Capital gamma
  {"key": "alt+j g", "command": "type", "args": {"text": "γ"}, "when": "editorTextFocus"},  // Gamma
  {"key": "alt+j shift+d", "command": "type", "args": {"text": "Δ"}, "when": "editorTextFocus"},  // Capital delta
  {"key": "alt+j d", "command": "type", "args": {"text": "δ"}, "when": "editorTextFocus"},  // Delta
  {"key": "alt+j shift+e", "command": "type", "args": {"text": "Ε"}, "when": "editorTextFocus"},  // Capital epsilon
  {"key": "alt+j e", "command": "type", "args": {"text": "ε"}, "when": "editorTextFocus"},  // Epsilon
  {"key": "alt+j shift+z", "command": "type", "args": {"text": "Ζ"}, "when": "editorTextFocus"},  // Capital zeta
  {"key": "alt+j z", "command": "type", "args": {"text": "ζ"}, "when": "editorTextFocus"},  // Zeta
  {"key": "alt+j shift+h", "command": "type", "args": {"text": "Η"}, "when": "editorTextFocus"},  // Capital eta
  {"key": "alt+j h", "command": "type", "args": {"text": "η"}, "when": "editorTextFocus"},  // Eta
  {"key": "alt+j shift+u", "command": "type", "args": {"text": "Θ"}, "when": "editorTextFocus"},  // Capital theta
  {"key": "alt+j u", "command": "type", "args": {"text": "θ"}, "when": "editorTextFocus"},  // Theta
  {"key": "alt+j shift+i", "command": "type", "args": {"text": "Ι"}, "when": "editorTextFocus"},  // Capital iota
  {"key": "alt+j i", "command": "type", "args": {"text": "ι"}, "when": "editorTextFocus"},  // Iota
  {"key": "alt+j shift+k", "command": "type", "args": {"text": "Κ"}, "when": "editorTextFocus"},  // Capital kappa
  {"key": "alt+j k", "command": "type", "args": {"text": "κ"}, "when": "editorTextFocus"},  // Kappa
  {"key": "alt+j shift+l", "command": "type", "args": {"text": "Λ"}, "when": "editorTextFocus"},  // Capital lambda
  {"key": "alt+j l", "command": "type", "args": {"text": "λ"}, "when": "editorTextFocus"},  // Lambda
  {"key": "alt+j shift+m", "command": "type", "args": {"text": "Μ"}, "when": "editorTextFocus"},  // Capital mu
  {"key": "alt+j m", "command": "type", "args": {"text": "μ"}, "when": "editorTextFocus"},  // Mu
  {"key": "alt+j shift+n", "command": "type", "args": {"text": "Ν"}, "when": "editorTextFocus"},  // Capital nu
  {"key": "alt+j n", "command": "type", "args": {"text": "ν"}, "when": "editorTextFocus"},  // Nu
  {"key": "alt+j shift+j", "command": "type", "args": {"text": "Ξ"}, "when": "editorTextFocus"},  // Capital xi
  {"key": "alt+j j", "command": "type", "args": {"text": "ξ"}, "when": "editorTextFocus"},  // Xi
  {"key": "alt+j shift+o", "command": "type", "args": {"text": "Ο"}, "when": "editorTextFocus"},  // Capital omicron
  {"key": "alt+j o", "command": "type", "args": {"text": "ο"}, "when": "editorTextFocus"},  // Omicron
  {"key": "alt+j shift+p", "command": "type", "args": {"text": "Π"}, "when": "editorTextFocus"},  // Capital pi
  {"key": "alt+j p", "command": "type", "args": {"text": "π"}, "when": "editorTextFocus"},  // Pi
  {"key": "alt+j shift+r", "command": "type", "args": {"text": "Ρ"}, "when": "editorTextFocus"},  // Capital rho
  {"key": "alt+j r", "command": "type", "args": {"text": "ρ"}, "when": "editorTextFocus"},  // Rho
  {"key": "alt+j shift+s", "command": "type", "args": {"text": "Σ"}, "when": "editorTextFocus"},  // Capital sigma
  {"key": "alt+j s", "command": "type", "args": {"text": "σ"}, "when": "editorTextFocus"},  // Sigma
  {"key": "alt+j shift+t", "command": "type", "args": {"text": "Τ"}, "when": "editorTextFocus"},  // Capital tau
  {"key": "alt+j t", "command": "type", "args": {"text": "τ"}, "when": "editorTextFocus"},  // Tau
  {"key": "alt+j shift+y", "command": "type", "args": {"text": "Υ"}, "when": "editorTextFocus"},  // Capital upsilon
  {"key": "alt+j y", "command": "type", "args": {"text": "υ"}, "when": "editorTextFocus"},  // Upsilon
  {"key": "alt+j shift+f", "command": "type", "args": {"text": "Φ"}, "when": "editorTextFocus"},  // Capital phi
  {"key": "alt+j f", "command": "type", "args": {"text": "φ"}, "when": "editorTextFocus"},  // Phi
  {"key": "alt+j shift+x", "command": "type", "args": {"text": "Χ"}, "when": "editorTextFocus"},  // Capital chi
  {"key": "alt+j x", "command": "type", "args": {"text": "χ"}, "when": "editorTextFocus"},  // Chi
  {"key": "alt+j shift+c", "command": "type", "args": {"text": "Ψ"}, "when": "editorTextFocus"},  // Capital psi
  {"key": "alt+j c", "command": "type", "args": {"text": "ψ"}, "when": "editorTextFocus"},  // Psi
  {"key": "alt+j shift+v", "command": "type", "args": {"text": "Ω"}, "when": "editorTextFocus"},  // Capital omega
  {"key": "alt+j v", "command": "type", "args": {"text": "ω"}, "when": "editorTextFocus"},  // Omega
  {"key": "alt+j alt+e", "command": "type", "args": {"text": "ϵ"}, "when": "editorTextFocus"},  // Epsilon (lunate)
  {"key": "alt+j alt+u", "command": "type", "args": {"text": "ϑ"}, "when": "editorTextFocus"},  // Theta (script)
  {"key": "alt+j alt+f", "command": "type", "args": {"text": "ϕ"}, "when": "editorTextFocus"},  // Phi (straight)
  {"key": "alt+j w", "command": "type", "args": {"text": "ς"}, "when": "editorTextFocus"},  // Sigma (final)
  {"key": "alt+j alt+p", "command": "type", "args": {"text": "ϖ"}, "when": "editorTextFocus"},  // Pi (varpi)
  {"key": "alt+j alt+r", "command": "type", "args": {"text": "ϱ"}, "when": "editorTextFocus"},  // Rho (varrho)
  // Superscripts & subscripts
  {"key": "alt+' 0", "command": "type", "args": {"text": "⁰"}, "when": "editorTextFocus"},  // Superscript 0
  {"key": "alt+, 0", "command": "type", "args": {"text": "₀"}, "when": "editorTextFocus"},  // Subscript 0
